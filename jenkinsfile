pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t java-docker-app:latest .'
            }
        }

        stage('Run Container') {
            steps {
                script {
                    bat(
                        returnStatus: true,
                        script: 'docker rm -f java-app'
                    )
                }

                bat 'docker run --name java-app java-docker-app:latest'
            }
        }
    }
}